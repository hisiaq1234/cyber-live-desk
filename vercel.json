{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'no build step'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/desk", "destination": "/api/desk" },
    { "source": "/control", "destination": "/api/control" },
    { "source": "/api/desk/:path*", "destination": "/api/desk" },
    { "source": "/api/twitch/eventsub", "destination": "/api/twitch-eventsub" },
    { "source": "/api/x/feed", "destination": "/api/x-feed" },
    { "source": "/api/x-timeline/:path*", "destination": "/api/x-timeline" },
    { "source": "/api/x-overlay/:path*", "destination": "/api/x-overlay" },
    { "source": "/api/spotify/top", "destination": "/api/spotify-top" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/desk",
      "permanent": false
    }
  ]
}